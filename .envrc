# direnv + nix-direnv: loads shell.nix (glew/glfw/glm/libx11/pkg-config) automatically.
use nix

# keep xmake pointed at the shell's compiler
export CC=gcc CXX=g++

# GUI: make sure GLFW picks the running Wayland session when available
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$(id -u)/wayland-0" ]; then
  export WAYLAND_DISPLAY=wayland-0
fi

# Per-machine overrides (proxy, extra env). Not committed.
if [ -f "$PWD/.envrc.local" ]; then
  source_env "$PWD/.envrc.local"
fi
